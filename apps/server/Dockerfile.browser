FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    libgtk-3-0 \
    libdbus-glib-1-2 \
    libxt6 \
    libx11-xcb1 \
    libasound2 \
    libgl1-mesa-dri \
    libglx-mesa0 \
    libegl-mesa0 \
    libgbm1 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Required for software WebGL rendering (no GPU in Docker)
ENV LIBGL_ALWAYS_SOFTWARE=1

# camoufox==0.4.11 passes "proxy":null which playwright>=1.54 rejects. Pin playwright to last good version.
RUN pip install --no-cache-dir "playwright==1.53.0" "camoufox[geoip]"
RUN python -m camoufox fetch

EXPOSE 4444

CMD ["python", "-c", "\
from camoufox.server import launch_server; \
launch_server(\
  headless=True,\
  port=4444,\
  ws_path='camoufox',\
  firefox_user_prefs={\
    'browser.sessionhistory.max_entries': 0,\
    'browser.sessionhistory.max_total_viewers': 0,\
    'javascript.options.mem.gc_incremental_slice_ms': 10,\
  }\
) \
"]
