NODE_ENV=test
PORT=3000
HOST=localhost

# Local/Docker helper values
APP_PORT=3000
FRONTEND_PORT=3001
HOST_IP=localhost

# Test database (Docker defaults)
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DB=loreo_test
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_POOL_MAX=10

CORS_ORIGINS=http://localhost:3001
