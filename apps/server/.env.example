# options: development | production | test
NODE_ENV=development

PORT=3000
HOST=localhost

# Local/Docker helper values
APP_PORT=3000
FRONTEND_PORT=3001
HOST_IP=localhost

# Database (PostgreSQL)
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DB=loreo
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_POOL_MAX=10

# Allowed CORS origins, comma-separated
CORS_ORIGINS=http://localhost:3001

# Authentication
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=50

# Body size limit (in bytes)
BODY_SIZE_LIMIT=102400

# Public/storage URLs
PUBLIC_URL=http://localhost:3000
STORAGE_PROVIDER=local
STORAGE_PATH=./data/storage

# S3-compatible storage (optional; required only when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=

# Browser automation service
BROWSER_URL=ws://localhost:4444/camoufox
